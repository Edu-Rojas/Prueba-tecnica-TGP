# Copia este archivo a .env y completa los valores. Nunca subas el .env al repo.

# --- Postgres (lo usa el contenedor db de docker compose) ---
POSTGRES_USER=leads
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=leads

# --- Aplicación ---
# Para correr la app fuera de Docker (uv run ...). Dentro de compose se sobreescribe con host "db".
DATABASE_URL=postgresql+asyncpg://leads:cambia-esto@localhost:5432/leads

# API key de Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=3
LLM_BACKOFF_SECONDS=1

WORKER_POLL_INTERVAL_SECONDS=2
WORKER_STALE_MINUTES=5
MAX_INTENTOS=3
# true solo en el deploy de Render (free tier): corre el worker dentro del proceso de la API.
RUN_WORKER_IN_API=false

LOG_LEVEL=INFO
